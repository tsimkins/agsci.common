<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      lang="en"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="agsci.common">
<body>

    <metal:content-core fill-slot="content-core">

<section
    tal:define="results view/results|nothing;
                jump_links python:view.jump_links(results)"
    class="col-12 px-0 col-lg-12 col-xl-12 px-lg-3 pb-4 order-12 order-lg-1 facultyStaffDirectory">

    <div id="parent-fieldname-text"
        tal:define="text context/aq_base/text|nothing"
        tal:condition="text"
        tal:content="structure python:context.text.output_relative_to(view.context)" />

        <div class="alphabetLinks html"
             tal:condition="context/show_jump_links|nothing">
            <ol>
                <li tal:repeat="letter jump_links">
                    <a tal:attributes="href python:u'%s#%s' % (context.absolute_url(), letter);"
                       tal:omit-tag="python: not jump_links[letter]">
                       <span tal:content="letter"
                             tal:omit-tag="python: jump_links[letter]" />
                    </a>
                </li>
            </ol>
        </div>
    <metal:listing define-macro="listing">
    <table
        tal:define="results results|view/results|nothing;
                    jump_links jump_links|python: [];
                    show_column nocall:view/show_column;
                    show_job_title python:show_column('job_title');
                    show_email python:show_column('email');
                    show_phone_number python:show_column('phone_number');
                    show_areas_expertise python:show_column('areas_expertise');
                    show_technology_focus_areas python:show_column('technology_focus_areas');
                    show_short_bio python:show_column('short_bio');
                    ">
        <thead>
            <tr>
                <th>Name</th>
                <th tal:condition="show_job_title">Title</th>
                <th tal:condition="show_email">Email</th>
                <th tal:condition="show_phone_number">Phone</th>
                <th tal:condition="show_areas_expertise">Areas of Expertise</th>
                <th tal:condition="show_technology_focus_areas">Technology Focus Areas</th>
                <th tal:condition="show_short_bio">Short Bio</th>
            </tr>
        </thead>
        <tbody>

    <tal:people
        tal:repeat="context results">

        <tal:person
            tal:define="person_view python:view.person_view(context);
                        data person_view/data|nothing"
            tal:condition="data">

            <tr class="html">
                <td>
                    <span
                        class="anchor"
                        tal:define="jump_links_id python:view.anchor(jump_links, context)"
                        tal:condition="jump_links_id">

                        <span
                            tal:attributes="id jump_links_id" />

                    </span>

                    <a
                        tal:attributes="href context/absolute_url|nothing;"
                        tal:content="person_view/name/title" />
                </td>
                <td tal:condition="show_job_title">
                    <span class="title jobTitle"
                        tal:define="job_titles context/job_titles|nothing"
                        tal:condition="job_titles"
                        tal:replace="python: job_titles[0]" />
                </td>
                <td tal:condition="show_email">
                    <a tal:define="email context/email|nothing"
                       tal:condition="email"
                       tal:attributes="href string:mailto:${email}"
                       tal:content="email" />
                </td>
                <td tal:condition="show_phone_number">
                    <a tal:define="phone_number context/phone_number|nothing"
                       tal:condition="phone_number"
                       tal:attributes="href string:tel:${phone_number}"
                       tal:content="phone_number" />
                </td>
                <td tal:condition="show_areas_expertise">
                    <ul tal:define="areas_expertise context/areas_expertise|nothing"
                        tal:condition="areas_expertise">
                        <li tal:repeat="i areas_expertise" tal:content="i"/>
                    </ul>
                </td>
                <td tal:condition="show_technology_focus_areas">
                    <ul tal:define="technology_focus_areas context/technology_focus_areas|nothing"
                        tal:condition="technology_focus_areas">
                        <li tal:repeat="i technology_focus_areas" tal:content="i"/>
                    </ul>
                </td>
                <td tal:condition="show_short_bio">
                    <div tal:define="short_bio context/short_bio/output|nothing;"
                         tal:condition="short_bio"
                         tal:replace="structure short_bio" />
                </td>

            </tr>

        </tal:person>

    </tal:people>
        </tbody>
    </table>

    </metal:listing>

</section>


    </metal:content-core>

</body>
</html>
